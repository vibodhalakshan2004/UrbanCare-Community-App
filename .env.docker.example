# Copy to .env (or export as environment vars) before running docker compose.

# PostgreSQL for local Docker stack
POSTGRES_DB=urbancare
POSTGRES_USER=urbancare
POSTGRES_PASSWORD=urbancare

# Backend local DB URL (overrides value in Backend/.env when needed)
DATABASE_URL=postgresql://urbancare:urbancare@db:5432/urbancare

# Build-time API URL baked into Flutter web build
FRONTEND_API_BASE_URL=http://localhost:8000
